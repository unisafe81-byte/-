{
  "name": "심리 유튜브 마케팅 엔진",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postInstallCommand": "npm install",
  "postStartCommand": "npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "앱 (채널 분석 대시보드)",
      "onAutoForward": "openBrowserOnce",
      "visibility": "public"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
